{
  "name": "lazy-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "alazy.app/relay/*", "zone_name": "alazy.app" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "GROUPS", "class_name": "Group" }, { "name": "PURCHASES", "class_name": "Purchase" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Group"] },
    { "tag": "v3", "new_sqlite_classes": ["Purchase"] }
  ]
}
